# Cache policy (keep in sync with README 「缓存」)
#
# IMPORTANT: Cloudflare COMBINES every matching rule's headers.
# Never set Cache-Control on /* together with /css/* /js/* /img/* —
# browsers then see two max-age values and keep behaving like max-age=0.
#
# - HTML pages (listed below): always revalidate → blog/copy updates show
# - /data/*: always revalidate → lists & article bodies
# - /css/* /js/*: 7 days + revalidate → shell; hard-refresh after CSS/JS ship
# - /img/*: 30 days + revalidate → media rarely changes

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/works/*
  Cache-Control: public, max-age=0, must-revalidate

/resume/*
  Cache-Control: public, max-age=0, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, must-revalidate

/contact/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=604800, must-revalidate

/js/*
  Cache-Control: public, max-age=604800, must-revalidate

/img/*
  Cache-Control: public, max-age=2592000, must-revalidate
