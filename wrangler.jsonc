{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-resume",
  "account_id": "95ecb1c0cae07e1ddbb0f3a33129cb85",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  // Custom domain resume.tensorview.cc is bound to this Worker name (my-resume).
  // Do not rename without also rebinding Workers → Domains.
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "resume.tensorview.cc",
      "custom_domain": true
    }
  ]
}
