# Syndicate auto-publish (local only — never commit real tokens)
# Copy to .env and fill in:

# Dev.to → Settings → Extensions → DEV Community API Keys
# https://dev.to/settings/extensions
DEVTO_API_KEY=

# Qiita → 設定 → アプリケーション → 個人用アクセストークン
# scopes: read_qiita + write_qiita
# https://qiita.com/settings/applications
QIITA_TOKEN=
